DB_PORT=5432


# LDAP (server & bind)
LDAP_SERVER=ldap://172.70.0.4
LDAP_USER_DN=cn=admin,dc=giys,dc=org
LDAP_PASSWORD=admin
LDAP_BASE_DN=dc=giys,dc=org

# Bizim yerleşim/senaryo parametreleri
LDAP_USER_PLACEMENT=under_group       # under_group | two_level
LDAP_GROUP_SCHEMA=groupOfNames        # groupOfNames | posixGroup | both
LDAP_AUTH_LOCK_METHOD=ppolicy         # ppolicy | shadow

# RabbitMQ
